            id='B',
            name='产品B (由2个A组成)',
            direct_metrics=PhysicalMetrics(labor_seconds=1800, mass_kg=0.1),
            bom=[BOMItem('A', 2.0)]
        ),
    }
    
    calculator = LPECalculator(sku_db)
    cost_A = calculator.get_intrinsic_cost('A')
    cost_B = calculator.get_intrinsic_cost('B')
    
